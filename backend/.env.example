# AssemblyAI API key for speech-to-text with word-level timestamps
ASSEMBLYAI_KEY=your_assemblyai_api_key

# Google Gemini API key or GCP credentials for LLM viral hook detection
GEMINI_API_KEY=your_gemini_api_key

# Groq API key for high-speed LLM fallback (Llama 3.3 70B)
GROQ_KEY=your_groq_api_key

# Server port and configuration
PORT=8000
HOST=0.0.0.0
STORAGE_DIR=./storage
LOG_LEVEL=INFO
