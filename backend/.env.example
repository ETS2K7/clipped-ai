# AssemblyAI API key for speech-to-text with word-level timestamps
ASSEMBLYAI_KEY=your_assemblyai_api_key

# LLM keys for viral hook detection (supports Gemini, Groq, and OpenRouter)
GEMINI_API_KEY=your_gemini_api_key
GROQ_KEY=your_groq_api_key
OPENROUTER_KEY=your_openrouter_api_key

# Server port and configuration
PORT=8000
HOST=0.0.0.0
STORAGE_DIR=./storage
LOG_LEVEL=INFO
